      <Choice value="PyTorch"/><Choice value="TensorFlow"/><Choice value="JAX"/>
      <Choice value="scikit-learn"/><Choice value="Keras"/><Choice value="ONNX"/>
      <Choice value="Pandas"/><Choice value="NumPy"/><Choice value="OpenCV"/>
      <Choice value="YOLO"/><Choice value="Transformer"/><Choice value="BERT"/>
      <Choice value="DeepSpeed"/><Choice value="SciPy"/>
      <Choice value="XGBoost"/><Choice value="LightGBM"/>
      <Choice value="CatBoost"/><Choice value="spaCy"/>
      <Choice value="머신러닝"/><Choice value="딥러닝"/>
      <Choice value="NLP"/><Choice value="컴퓨터비전"/>
      <Choice value="강화학습"/><Choice value="시계열"/>
      <Choice value="이상탐지"/><Choice value="추천시스템"/>
    </Choice>
    <Choice value="Vision/Multimodal">
      <Choice value="VLM"/><Choice value="CLIP"/>
      <Choice value="Stable Diffusion"/><Choice value="Multimodal"/>
      <Choice value="SAM"/><Choice value="Object Detection"/>
    </Choice>
    <Choice value="LLM/AI Agent">
      <Choice value="LLM"/><Choice value="RAG"/><Choice value="GPT"/>
      <Choice value="LangChain"/><Choice value="LangGraph"/><Choice value="LangSmith"/>
      <Choice value="LlamaIndex"/><Choice value="CrewAI"/><Choice value="AutoGen"/>
      <Choice value="HuggingFace"/><Choice value="OpenAI API"/><Choice value="Claude API"/>
      <Choice value="Gemini"/><Choice value="Llama"/><Choice value="Mistral"/>
      <Choice value="Whisper"/><Choice value="vLLM"/><Choice value="Ollama"/>
      <Choice value="LoRA"/><Choice value="PEFT"/>
      <Choice value="Fine-tuning"/><Choice value="Prompt Engineering"/>
      <Choice value="AI Agent"/><Choice value="MCP"/><Choice value="Function Calling"/>
      <Choice value="생성형 AI"/>
    </Choice>
    <Choice value="Vector DB">
      <Choice value="Vector DB"/><Choice value="Pinecone"/>
      <Choice value="ChromaDB"/><Choice value="Weaviate"/>
      <Choice value="Milvus"/><Choice value="Qdrant"/>
      <Choice value="FAISS"/><Choice value="pgvector"/>
    </Choice>
    <Choice value="MLOps">
      <Choice value="MLOps"/><Choice value="MLflow"/><Choice value="Kubeflow"/>
      <Choice value="Weights &amp; Biases"/><Choice value="DVC"/>
      <Choice value="Triton"/><Choice value="BentoML"/><Choice value="TensorRT"/>
      <Choice value="Streamlit"/><Choice value="Gradio"/>
    </Choice>
    <Choice value="데이터 엔지니어링">
      <Choice value="Spark"/><Choice value="Hadoop"/><Choice value="Airflow"/>
      <Choice value="Kafka"/><Choice value="Flink"/><Choice value="dbt"/>
      <Choice value="Snowflake"/><Choice value="BigQuery"/>
      <Choice value="Databricks"/><Choice value="Delta Lake"/>
      <Choice value="Polars"/><Choice value="DuckDB"/>
      <Choice value="Trino"/><Choice value="Prefect"/><Choice value="Dagster"/>
      <Choice value="데이터엔지니어링"/>
    </Choice>
    <Choice value="DB">
      <Choice value="MySQL"/><Choice value="PostgreSQL"/>
      <Choice value="MongoDB"/><Choice value="Redis"/>
      <Choice value="Elasticsearch"/><Choice value="DynamoDB"/>
      <Choice value="Oracle"/><Choice value="Neo4j"/>
      <Choice value="Cassandra"/><Choice value="ClickHouse"/>
      <Choice value="CockroachDB"/>
    </Choice>
    <Choice value="인프라/DevOps">
      <Choice value="Docker"/><Choice value="Kubernetes"/>
      <Choice value="AWS"/><Choice value="GCP"/><Choice value="Azure"/>
      <Choice value="Terraform"/><Choice value="CI/CD"/>
      <Choice value="Jenkins"/><Choice value="GitHub Actions"/>
      <Choice value="ArgoCD"/><Choice value="Linux"/><Choice value="Nginx"/>
      <Choice value="Git"/><Choice value="Grafana"/>
      <Choice value="Prometheus"/><Choice value="Datadog"/>
      <Choice value="Ansible"/><Choice value="Helm"/><Choice value="Istio"/>
      <Choice value="OpenTelemetry"/><Choice value="Sentry"/>
      <Choice value="ELK Stack"/><Choice value="Pulumi"/><Choice value="Serverless"/>
    </Choice>
    <Choice value="테스팅">
      <Choice value="Selenium"/><Choice value="Playwright"/>
      <Choice value="Jest"/><Choice value="Cypress"/>
    </Choice>
  </Taxonomy>
  <Header value="↳ 목록에 없는 기술이 있으면 아래에 콤마(,)로 구분하여 입력" size="5"/>
  <TextArea name="custom_techs" toName="position_detail"
            placeholder="예: UiPath, Blue Prism, SAP. 목록에서 모두 선택했으면 비워두세요."
            rows="1" maxSubmissions="1" editable="true" required="false"/>

  <!-- 검수 메모 -->
  <Header value="검수 메모 (선택사항)" size="5"/>
  <TextArea name="review_note" toName="position_detail"
            placeholder="도메인/기술스택 변경 이유나 특이사항을 기록하세요"
            rows="2" maxSubmissions="1" editable="true" required="false"/>
</View>
