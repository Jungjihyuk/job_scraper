{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "strict": true,
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
